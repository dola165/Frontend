# May be relative for a same-origin reverse proxy or absolute for local/cross-origin use.
# Media (/uploads) and WebSocket (/ws-chat) URLs are derived as siblings of /api.
VITE_API_BASE_URL=http://localhost:8080/api
VITE_GOOGLE_CLIENT_ID=
# Map v2 "Tilted" mode uses MapTiler streets-v2 — same key as the Android app (MAPLIBRE_API_KEY).
# Leave blank to disable the Tilted option in the map mode control.
VITE_MAPTILER_API_KEY=

# Opt-in fictional browser data for local demos. Keep false for any production build.
# Demo-only extension screens show an explicit Local demo notice when enabled.
VITE_ENABLE_MOCKS=false

# Temporary payment simulation on the real cart/campaign pages.
# Defaults to on in local development and off in production builds.
# Set true for a prelaunch preview build; set false for launch.
VITE_PAYMENT_PREVIEW=
