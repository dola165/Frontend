# May be relative for a same-origin reverse proxy or absolute for local/cross-origin use.
# Media (/uploads) and WebSocket (/ws-chat) URLs are derived as siblings of /api.
VITE_API_BASE_URL=http://localhost:8080/api
VITE_GOOGLE_CLIENT_ID=
# Map v2 "Tilted" mode uses MapTiler streets-v2 — same key as the Android app (MAPLIBRE_API_KEY).
# Leave blank to disable the Tilted option in the map mode control.
VITE_MAPTILER_API_KEY=
